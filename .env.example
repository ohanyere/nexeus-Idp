# Auth mode:
# - github: production Auth.js GitHub OAuth
# - mock: local demo-only login
NEXT_PUBLIC_AUTH_MODE=github

# Auth.js / GitHub OAuth.
# For local development, set NEXTAUTH_URL=http://localhost:3000.
# For Vercel, set NEXTAUTH_URL to the deployed app URL unless your Vercel system envs cover it.
NEXTAUTH_URL=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional. Raises Auth.js/OpenID HTTP timeout above the 3500ms library default for slow local networks.
AUTH_GITHUB_OAUTH_TIMEOUT_MS=10000

# Managed PostgreSQL for Vercel, local PostgreSQL for development.
DATABASE_URL=

# GitHub platform automation.
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_TEMPLATE_OWNER=
GITHUB_TEMPLATE_REPO_GO_API=
GITHUB_TEMPLATE_REPO_NODE_API=
GITHUB_TEMPLATE_REPO_PYTHON_API=
GITHUB_TEMPLATE_REPO_NEXTJS_FRONTEND=
GITHUB_TEMPLATE_REPO_WORKER_SERVICE=

# Docker Hub credentials written into generated repositories for CI.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Runtime state integrations.
ARGOCD_BASE_URL=
ARGOCD_TOKEN=
KUBERNETES_API_URL=
KUBERNETES_BEARER_TOKEN=
